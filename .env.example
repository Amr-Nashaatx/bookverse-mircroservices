# Copy to .env.dev and fill in. That filename is what the tooling expects:
#   npm run compose  ->  docker compose --env-file .env.dev up
#
# The same file is consumed two different ways, and it is worth knowing which
# is which before adding a variable.
#
#   --env-file .env.dev   (the CLI flag) fills in ${...} placeholders in
#                         docker-compose.yml. It runs before any container
#                         exists and puts nothing into one. Drop the flag and
#                         ${DB_PASSWORD} silently becomes an empty string.
#
#   env_file: ./.env.dev  (in every service block) injects this whole file into
#                         that container as environment variables. This is how
#                         application code receives everything below.
#
# A variable only needs to be here if one of those two needs it. Per-service
# values (PORT, the *_SERVICE_URL entries) are set directly in the
# `environment:` block of docker-compose.yml instead, because they differ per
# service. `environment:` wins over `env_file:` when both set the same key.


# ---------------------------------------------------------------------------
# Read by docker-compose.yml itself (${...} interpolation)
# ---------------------------------------------------------------------------

# Postgres superuser credentials. DB_PASSWORD becomes POSTGRES_PASSWORD on the
# postgres container; DB_USER is only referenced by its healthcheck and
# defaults to `postgres` if unset.
DB_USER=postgres
DB_PASSWORD=

# RabbitMQ credentials for the broker container. Application code also builds
# its AMQP URL from these when RABBITMQ_URL is not set.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# development | production. Guards the dev-only fault injector in each service
# (x-fault-delay / x-fault-status), which must never be reachable in prod.
NODE_ENV=development


# ---------------------------------------------------------------------------
# Read by application code (delivered via env_file:)
# ---------------------------------------------------------------------------

# One database per service, all on the one Postgres instance. The host must be
# `postgres` (the compose service name) -- host-side Prisma commands rewrite it
# to localhost themselves, see scripts/lib/service-db.mjs.
AUTH_SERVICE_DATABASE_URL=postgresql://postgres:PASSWORD@postgres:5432/auth_db
BOOK_SERVICE_DATABASE_URL=postgresql://postgres:PASSWORD@postgres:5432/books_db
REVIEW_SERVICE_DATABASE_URL=postgresql://postgres:PASSWORD@postgres:5432/reviews_db

# Signs and verifies the user's access token. The gateway verifies it and
# auth-service issues it, so both must agree.
ACCESS_TOKEN_JWT_SECRET=

# Signs the refresh-token cookie.
COOKIE_SIGN_SECRET=

# Proves a request came from the gateway rather than from anything else that
# can reach the container network -- the Lesson 01 trust boundary.
# GATEWAY_SECRET is what the gateway sends. GATEWAY_ACCEPTED_SECRETS is the
# comma-separated list each service will accept, so a rotation can list the old
# and new value at once and retire the old one afterwards.
GATEWAY_SECRET=
GATEWAY_ACCEPTED_SECRETS=

# Token lifetimes. Both optional, but note they are NOT the same format:
#   ACCESS_TOKEN_EXPIRES_IN   a duration STRING ("15m", "7d"), default 15m
#   REFRESH_TOKEN_EXPIRES_IN  MILLISECONDS as a number, default 604800000 (7d)
# Putting "7d" in the second one is not an error you will be told about:
# Number("7d") is NaN, which falls through to the default.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=604800000

# Optional. Built from RABBITMQ_DEFAULT_USER/PASS when unset.
# RABBITMQ_URL=amqp://user:pass@rabbitmq:5672
