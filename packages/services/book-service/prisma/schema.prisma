generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Book {
  id            String     @id @default(uuid())
  title         String
  // The user who created the book. Ownership checks compare this to request.user.id.
  // Named for the User it points at, not for the "author" role: an Author is a
  // separate thing (pen name, approval status) that this service does not know about.
  ownerUserId   String
  genre         String[]
  description   String
  coverImageUrl String?
  status        BookStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([ownerUserId])
}

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model IdempotencyKey {
  key         String
  // The user the key is scoped to, so two callers can send the same key string.
  ownerUserId String
  requestHash String
  bookId      String?
  createdAt   DateTime @default(now())

  @@unique([ownerUserId, key])
  @@index([createdAt])
}
