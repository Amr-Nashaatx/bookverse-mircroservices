generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Book {
  id            String     @id @default(uuid())
  title         String
  // The user who created the book. Ownership checks compare this to request.user.id.
  // Named for the User it points at, not for the "author" role: an Author is a
  // separate thing (pen name, approval status) that this service does not know about.
  ownerUserId   String
  genre         String[]
  description   String
  coverImageUrl String?
  status        BookStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  version       Int        @default(0)

  reviewsAvgRating   Float?
  reviewsCount       Int       @default(0)
  reviewsLastRefresh DateTime?
  reviewsVersion     Int?

  @@index([ownerUserId])
  // One index per offered ordering (BookSortValues). Shape is always
  // (status, <sort column> <direction>, id): status is an equality filter so it
  // collapses to one contiguous block, and inside that block rows are already
  // in the exact order the query asks for — no sort step, and drafts are never
  // fetched.
  //
  // The two on nullable columns need NULLS LAST, which Prisma's @@index cannot
  // express, so their migrations are hand-edited. See those files: without it
  // the index is unusable for that ordering and Postgres full-sorts instead.
  @@index([status, publishedAt(sort: Desc), id]) // newest
  @@index([status, reviewsAvgRating(sort: Desc), id]) // top-rated
  @@index([status, title, id]) // a-z — non-null, so no NULLS clause needed
}

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model IdempotencyKey {
  key         String
  // The user the key is scoped to, so two callers can send the same key string.
  ownerUserId String
  requestHash String
  bookId      String?
  createdAt   DateTime @default(now())

  @@unique([ownerUserId, key])
  @@index([createdAt])
}

/* Events waiting to be sent. Written in the same transaction as the change
 * they describe; the relay sends them and marks them sent. */
model Outbox {
  id         Int       @id @default(autoincrement()) // relay order
  eventId    String    @unique @default(uuid()) // created here, in the transaction; sent as messageId
  exchange   String
  routingKey String
  payload    Json
  createdAt  DateTime  @default(now())
  sentAt     DateTime?
}
