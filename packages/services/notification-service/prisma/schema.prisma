generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* One table for every kind of notification. What differs per kind lives in
 * `data`; the columns are only what every kind has. */
model Notification {
  id String @id @default(uuid())

  // The recipient.
  userId String

  // The routing key of the event that produced it, e.g. "review.posted".
  type String

  // The messageId of that event, created with the outbox row and kept across
  // re-sends. Unique, so the second copy of an event is refused here.
  eventId String @unique

  // Rendered once, when the notification is made. A later rename of the book
  // does not rewrite what the reader was told.
  message String

  // Kind-specific fields a client needs to link somewhere (bookId, reviewId…).
  data Json

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc), id])
}
