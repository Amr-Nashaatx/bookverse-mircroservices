generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Review {
  id String @id @default(uuid())

  bookId String
  userId String

  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, userId])
}

model BookReviewVersion {
  bookId  String @id @default(uuid())
  version Int
}

model BookStatus {
  bookId  String @id
  status  String
  version Int
}

model Outbox {
  id         Int       @id @default(autoincrement()) // relay order
  eventId    String    @unique @default(uuid()) // created here, in the transaction; sent as messageId
  exchange   String
  routingKey String
  payload    Json
  createdAt  DateTime  @default(now())
  sentAt     DateTime?
}
